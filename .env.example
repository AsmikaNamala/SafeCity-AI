# Database Configuration
DATABASE_URL=postgresql://safecity_user:safecity_password@localhost:5432/safecity_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=safecity_db
DATABASE_USER=safecity_user
DATABASE_PASSWORD=safecity_password

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
ENVIRONMENT=development

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# React Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WEBSOCKET_URL=ws://localhost:8000
REACT_APP_MAPBOX_TOKEN=your-mapbox-token
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_PROJECT_ID=your-firebase-project-id

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@safecity-ai.com

# SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AI Model Configuration
YOLOV8_MODEL_PATH=./ai_models/pretrained_models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.4

# AQI API
AQI_API_KEY=your-aqi-api-key
AQI_API_URL=https://api.openweathermap.org/data/2.5/air_pollution

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/safecity.log

# Feature Flags
ENABLE_ACCIDENT_DETECTION=True
ENABLE_SOS_ALERTS=True
ENABLE_POLLUTION_MONITORING=True
ENABLE_ANALYTICS=True
ENABLE_REAL_TIME_UPDATES=True

# City Configuration
CITY_NAME=YourCity
CITY_LAT=0.0
CITY_LNG=0.0
CITY_TIMEZONE=UTC

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0